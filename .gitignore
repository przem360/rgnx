# =================================================================
# RGNX Project - Git Ignore Configuration
# =================================================================

# 1. Ignore the entire Buildroot source directory
# (This keeps your repo clean of thousands of external files)
/buildroot-2026.02.1/

# 2. Ignore any local build artifacts or temporary files
# in the root directory
*.log
*.tmp
*.swp
.DS_Store

# 3. Ignore submodule build artifacts
/buildroot-src/output/
/buildroot-src/dl/
/buildroot-src/.config
/buildroot-src/.config.old

# 4. If you ever decide to run a build that creates an 'output' 
# folder in the root directory, ignore it too
/output/

# 5. Do NOT ignore your board and configs directories
# (Even if they contain files named *.config, they are safe 
# because they are not in the root directory's ignored patterns)
!/board/
!/configs/

# 6. Temporary stuff
steps.txt
qemu.txt
floppinux.md
